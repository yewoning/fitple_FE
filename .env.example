# 실제 기기에서는 localhost 대신 개발 PC의 LAN 주소를 사용하세요.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# api-first: API 우선, 연결 실패/5xx 시 목업 폴백
# mock-only: 네트워크 없이 목업만 사용 (발표 권장)
# api-only: 목업 폴백 없이 API 오류 확인
EXPO_PUBLIC_DATA_MODE=api-first

# owner: 기준 프로젝트 생성자 / applicant: 비생성 지원자
EXPO_PUBLIC_DEMO_USER_ROLE=owner
